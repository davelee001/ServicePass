{
  "name": "servicepass-backend",
  "version": "1.0.0",
  "description": "Backend service for ServicePass voucher redemption system",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "create-admin": "node ../scripts/createAdmin.js",
    "test:config": "node --test test/productionConfig.test.js test/sanitization.test.js",
    "test:dependencies": "node --test test/dependencyCompatibility.test.js",
    "test:redemption": "node --test test/qrRedemption.test.js",
    "test:sdk": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.sdk.config.cjs --runInBand",
    "test:expiry": "node --test test/voucherExpiry.test.js"
  },
  "keywords": [
    "blockchain",
    "vouchers",
    "sui",
    "web3"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "qrcode": "^1.5.3",
    "winston": "^3.11.0",
    "@mysten/sui": "^2.35.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/__tests__/setup.js"
    ]
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    }
  }
}
