# Server Configuration
PORT=3000
NODE_ENV=development

# SUI Blockchain Configuration
SUI_NETWORK=testnet
PACKAGE_ID=
ADMIN_CAP_ID=
REGISTRY_ID=
ADMIN_PRIVATE_KEY=
VOUCHER_PACKAGE_ID=

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/servicepass

# Optional MongoDB Performance Tuning
# MONGODB_MAX_POOL_SIZE=20
# MONGODB_MIN_POOL_SIZE=5
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000
# MONGODB_SOCKET_TIMEOUT_MS=45000

# JWT Authentication Configuration
JWT_SECRET=
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# Redis (for BullMQ event queue)
REDIS_URL=redis://localhost:6379

# Security Configuration
ENCRYPTION_KEY=
QR_SIGNING_SECRET=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Data Archival (Redemptions)
# REDEMPTION_ARCHIVE_AFTER_DAYS=180
# REDEMPTION_ARCHIVE_BATCH_SIZE=500

# Secret-manager file inputs (use either NAME or NAME_FILE, never both)
# JWT_SECRET_FILE=/run/secrets/jwt_secret
# ENCRYPTION_KEY_FILE=/run/secrets/encryption_key
# QR_SIGNING_SECRET_FILE=/run/secrets/qr_signing_secret
# ADMIN_PRIVATE_KEY_FILE=/run/secrets/admin_private_key
# MONGODB_URI_FILE=/run/secrets/mongodb_uri
# REDIS_URL_FILE=/run/secrets/redis_url
