# Docker Compose Environment Variables Example
# Development only: copy to .env and supply generated secrets.
# Production uses docker-compose.production.yml and .env.production.example.

# === Database Configuration ===
MONGODB_PASSWORD=

# === Security Secrets (REQUIRED - Change in Production) ===
JWT_SECRET=
ENCRYPTION_KEY=
QR_SIGNING_SECRET=

# === SUI Blockchain Configuration (REQUIRED) ===
SUI_NETWORK=testnet
PACKAGE_ID=
ADMIN_CAP_ID=
REGISTRY_ID=
ADMIN_PRIVATE_KEY=

# === Email Configuration (Optional) ===
EMAIL_SERVICE=gmail
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@servicepass.com

# === SMS Configuration - Twilio (Optional) ===
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# === Push Notifications - Firebase (Optional) ===
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# === Development Tools ===
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=
